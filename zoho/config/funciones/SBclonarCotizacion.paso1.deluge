// PASO 1 — SOLO SANDBOX. Botón ORIGINAL "Clonar Cotización" → función "SB Clonar Cotizacion".
// Igual a la versión vigente (SBclonarCotizacion.actual.deluge): misma firma, mismo
// Cotizador, mismas fases. ÚNICO cambio:
//   v3 (24-11): en Cerrada Ganada el botón original YA NO abre el Cotizador; avisa
//   que no se puede clonar desde aquí. Las Ganadas se clonan solo con el botón nuevo
//   "Clonar Cotización (prueba)" (widget con aviso Sí/No).
//   (v2 del 19-11 abría el Cotizador en pestaña nueva en Ganada: reemplazada.)
// Volver atrás: pegar SBclonarCotizacion.actual.deluge.
string button.SBclonarCotizacion(String idCreator,String fase)
{
ambiente = standalone.SBvalidarAmbiente();
if(ambiente == "Sandbox")
{
	urlClonar = "https://creatorapp.zoho.com/emaresa/environment/development/cotizador#Form:Generar_Cotizaciones?Clonar_Cot=" + idCreator;
}
else
{
	urlClonar = "https://creatorapp.zoho.com/emaresa/cotizador#Form:Generar_Cotizaciones?Clonar_Cot=" + idCreator;
}
if(fase == "Cerrada Ganada")
{
	// No abre el Cotizador: las Ganadas pasan por el botón nuevo con aviso
	return "No se puede clonar una cotización Cerrada Ganada con este botón. Use el botón \"Clonar Cotización (prueba)\".";
}
if(fase == "Creada" || fase == "Cotización Aprobada" || fase == "Cotización Rechazada" || fase == "Enviada" || fase == "Cerrada Perdida" || fase == "Lista para Clonar")
{
	openUrl(urlClonar,"parent window");
	return "";
}
return "La cotización esta en fase \"" + fase + "\" que no se permite clonar!";
}
