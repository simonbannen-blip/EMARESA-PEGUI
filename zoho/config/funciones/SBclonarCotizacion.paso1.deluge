// PASO 1 — SOLO SANDBOX (2026-11-19). Botón "Clonar Cotización" → función "SB Clonar Cotizacion".
// Igual a la versión vigente (SBclonarCotizacion.actual.deluge): mismas fases permitidas,
// misma firma, mismo Cotizador. ÚNICO cambio: cuando la cotización está
// Cerrada Ganada, abre el Cotizador en una PESTAÑA NUEVA y deja en el CRM un
// aviso sobre los datos que debe tener el cliente (mismo o nuevo).
// v2 (19-11): con "parent window" el aviso duraba segundos porque la página se
// reemplazaba por el Cotizador → en Cerrada Ganada se usa "new window".
string button.SBclonarCotizacion(String idCreator,String fase)
{
ambiente = standalone.SBvalidarAmbiente();
if(ambiente == "Sandbox")
{
	urlClonar = "https://creatorapp.zoho.com/emaresa/environment/development/cotizador#Form:Generar_Cotizaciones?Clonar_Cot=" + idCreator;
}
else
{
	urlClonar = "https://creatorapp.zoho.com/emaresa/cotizador#Form:Generar_Cotizaciones?Clonar_Cot=" + idCreator;
}
if(fase == "Cerrada Ganada")
{
	// Pestaña nueva: el CRM queda abierto mostrando el aviso con su botón Aceptar
	openUrl(urlClonar,"new window");
	return "Se abrió el Cotizador en una pestaña nueva para clonar esta cotización Cerrada Ganada. Se creará una oportunidad nueva. Puede dejar el mismo cliente o cambiarlo por otro; el cliente debe tener Contacto, Sucursal del Cliente (y Obra en Rental) y Plazo/Forma de Pago, o el Cotizador no dejará guardar.";
}
if(fase == "Creada" || fase == "Cotización Aprobada" || fase == "Cotización Rechazada" || fase == "Enviada" || fase == "Cerrada Perdida" || fase == "Lista para Clonar")
{
	openUrl(urlClonar,"parent window");
	return "";
}
return "La cotización esta en fase \"" + fase + "\" que no se permite clonar!";
}
